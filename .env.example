# ==========================================
# AVIORA — Environment Variables Template
# Copy this file to `.env` and insert your real values.
# NEVER commit `.env` to GitHub or public repositories.
# ==========================================

# Firebase Phone Authentication
VITE_FIREBASE_API_KEY="your-firebase-api-key-here"
VITE_FIREBASE_AUTH_DOMAIN="your-project-id.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="your-project-id"
VITE_FIREBASE_STORAGE_BUCKET="your-project-id.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="your-messaging-sender-id"
VITE_FIREBASE_APP_ID="your-app-id"
VITE_FIREBASE_MEASUREMENT_ID="G-MEASUREMENT_ID"

# Fast2SMS Gateway (Optional Fallback)
FAST2SMS_API_KEY="your-fast2sms-api-key"
FAST2SMS_OTP_ID=""

# Supabase Database (Optional Custom Instance)
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""

# WhatsApp Meta Cloud API (Optional Concierge)
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_ACCESS_TOKEN=""

# Razorpay Payment Gateway (Online Settlements - configure in Vercel Environment Variables)
VITE_RAZORPAY_KEY_ID="rzp_test_your_key_id"
RAZORPAY_KEY_ID="rzp_test_your_key_id"
RAZORPAY_KEY_SECRET=""
